# ============================================
# Stonkfly 環境變數設定
# 複製此檔為 .env 並填入你的 API 金鑰
# ============================================

# ---- 真實交易確認（必填，否則無法啟用 live 模式）----
STONKFLY_LIVE=I_ACCEPT_REAL_TRADES

# ---- Binance API 金鑰 ----
# 在 Binance 後台建立 API Key：
#   1. 登入 Binance → 個人資料 → API 管理
#   2. 建立 API Key，開啟「現貨及槓桿交易」權限
#   3. 【重要】絕對不要開啟「提現」權限
#   4. 建議設定 IP 白名單
BINANCE_API_KEY=你的_API_KEY
BINANCE_API_SECRET=你的_API_SECRET

# ---- 網路選擇 ----
# true = 測試網（testnet，使用假錢，安全）
# false = 主網（mainnet，真實交易，有風險）
BINANCE_TESTNET=true

# ---- 交易對 ----
BINANCE_SYMBOL=BTCUSDT

# ---- Coinbase API（如使用 Coinbase）----
# COINBASE_KEY_FILE=/path/to/coinbase_cloud_api_key.json
# COINBASE_PORTFOLIO_ID=你的_portfolio_uuid
